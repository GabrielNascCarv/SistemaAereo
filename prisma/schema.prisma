// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Voo {
  id          Int      @id @default(autoincrement())
  numeroVoo   String   @unique
  origem      String
  destino     String
  dataPartida DateTime
  dataChegada DateTime
  assentosDisponiveis Int
  preco       Float
  status      String   @default("AGENDADO") // AGENDADO, CANCELADO, CONCLUIDO
  
  // Relação com Reservas (via trechos — um voo pode ser perna de várias reservas)
  trechos     ReservaTrecho[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("voos")
}

model Passageiro {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  cpf       String   @unique
  telefone  String?
  
  // Relação com Reservas
  reservas  Reserva[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("passageiros")
}

model Reserva {
  id           Int      @id @default(autoincrement())
  codigoReserva String  @unique
  dataReserva  DateTime @default(now())
  status       String   @default("PENDENTE_PAGAMENTO") // PENDENTE_PAGAMENTO, CONFIRMADA, CANCELADA
  numeroPassageiros Int

  // Uma reserva tem 1+ trechos (conexões) para a ida e, se for ida e volta, 1+ para a volta
  trechos      ReservaTrecho[]

  passageiroId Int
  passageiro   Passageiro @relation(fields: [passageiroId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reservas")
}

model ReservaTrecho {
  id        Int      @id @default(autoincrement())

  reservaId Int
  reserva   Reserva  @relation(fields: [reservaId], references: [id], onDelete: Cascade)

  vooId     Int
  voo       Voo      @relation(fields: [vooId], references: [id])

  direcao   String   // IDA, VOLTA
  ordem     Int      // posição do trecho dentro da direção (1 = primeiro, 2 = conexão seguinte...)

  createdAt DateTime @default(now())

  @@unique([reservaId, direcao, ordem])
  @@map("reserva_trechos")
}