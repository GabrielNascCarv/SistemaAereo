DATABASE_URL="postgresql://usuario:senha@localhost:5432/sistema_aereo?schema=public"

# Gateway de busca de voos externos (Duffel — https://duffel.com/docs/api)
# Crie uma conta gratuita em duffel.com e use um token de teste (test_...)
DUFFEL_API_TOKEN="test_..."
DUFFEL_BASE_URL="https://api.duffel.com"

# Origens autorizadas a chamar a API (separadas por vírgula). Em produção,
# a URL do frontend publicado (ex: Vercel). Sem essa variável, libera geral
# (uso local/dev).
CORS_ORIGIN="http://localhost:5173"

# Porta em que a API sobe. A maioria das plataformas de deploy (Render etc)
# injeta essa variável automaticamente — não precisa setar manualmente lá.
PORT=3000
